# 复制为 .env 后按需修改；与前端 API_PORT / VUE_APP_API_PORT 保持一致
API_PORT=8000
API_HOST=0.0.0.0

# 本机 Mongo 若使用带后缀的测试资产代码（如 SH000300_TEST），填写后缀（须与库内大小写一致），例如:
# MONGO_ASSET_CODE_SUFFIX=_TEST
MONGO_ASSET_CODE_SUFFIX=

# 调试 OpenAI/httpx 出站 HTTP：设为 1 后重启 uvicorn；启动时应出现 [DEBUG_HTTPX] ...（stderr）
# PowerShell: $env:DEBUG_HTTPX='1'  （不要写成 $env:DEBUG_HTTPX = '1'，变量名可能带空格会失效）
# DEBUG_HTTPX=1

# AI Agent Configuration
LLM_API_KEY=sk-xxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 软工具模式：系统默认启用，统一内外网行为
# 如需临时切回原生 tools 模式（不推荐），可设为 false
LLM_SOFT_TOOLS=true
AGENT_MAX_TOOL_ROUNDS=10
AGENT_CONVERSATION_MAX_HISTORY=50
# 单条工具返回注入 LLM 前的最大字符数。多 ETF/大表分析若仍提示截断，可调大如 20000~40000（注意总上下文与费用）
# AGENT_TOOL_RESULT_MAX_CHARS=12000
# 多模型降级（可选）：JSON 数组字符串，见 app/agent/core/config.py 注释
# LLM_MODELS=

# DataHub / 主体舆情：同一会话内上游同步成功一次后，后续 subject_risk_search 默认仅查本地库（减重复 API 与大结果截断）。设为 false 则每次调用仍可尝试上游（旧行为）
# AGENT_SUBJECT_RISK_ONE_SYNC_PER_CONVERSATION=true

# DataHub / 理财产品信息：同一会话内每个产品 connector 上游同步成功一次后，后续 product_hub_query 默认仅查本地（行为与主体舆情类似）。设为 false 则每次可再尝试上游
# AGENT_PRODUCT_HUB_ONE_SYNC_PER_CONVERSATION=true

# Data Hub 上游数据接入配置（getPyResult 通用入口）
DATA_HUB_UPSTREAM_URL=http://zylcorms.wmverify.com:8080/jxdatamid/apiManage/getPyResult
# 上游请求超时（秒）
DATA_HUB_UPSTREAM_TIMEOUT=180.0
# 主体舆情风险资源名
SUBJECT_RISK_RESOURCE=adm_subject_opinion_risk_stats
# 理财产品信息资源名
PTL_INFO_RESOURCE=ZYSC_DWD_PTL_INFO
# 持有人汇总资源名
HOLDER_RESOURCE=ZYSC_DWD_PTL_HOLDER_SUMMARY
